{
  "Seo": {
    "CanonicalHost": "houseofvacation.com",
    "ForceHttps": true,
    "ForceLowercase": true,
    "ForceTrailingSlash": true,
    "JunkQueryKeys": [ "no-cache", "attachment_id", "replytocom" ],
    "SkipPrefixes": [
      "/wp-content/uploads/",
      "/.well-known/",
      "/assets/",
      "/css/",
      "/js/",
      "/images/"
    ]
  },

  "NotFound": {
    "AlwaysRedirect": false,
    "FallbackUrl": "/",
    "NotFoundPage": "/page-not-found/",
    "MatchThreshold": 0.5
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "HouseOfVacation.Seo": "Information"
    }
  },

  "AllowedHosts": "*"
}
