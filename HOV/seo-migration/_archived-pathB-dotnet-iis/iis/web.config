<?xml version="1.0" encoding="utf-8"?>
<!--
  House of Vacation - SEO redirect layer for IIS
  Requires: IIS URL Rewrite Module 2.1 (pre-installed on SmartASP.NET and
            GoDaddy Windows plans; on a VPS install it from iis.net)

  Canonical host: https://houseofvacation.com  (non-www, HTTPS, trailing slash)
  Rules run top to bottom. stopProcessing="true" ends the pass, so ORDER MATTERS.
-->
<configuration>

  <system.webServer>

    <!-- ===================================================================
         ASP.NET Core hosting (remove this block for a static/MVC5 site)
         =================================================================== -->
    <handlers>
      <add name="aspNetCore" path="*" verb="*"
           modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet"
                arguments=".\HouseOfVacation.dll"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess" />

    <rewrite>
      <rules>

        <!-- ============================================================
             0. Never rewrite the ACME challenge or the uploads folder.
                /wp-content/uploads/ MUST keep working - 30 live images.
             ============================================================ -->
        <rule name="Skip ACME" stopProcessing="true">
          <match url="^\.well-known/" />
          <action type="None" />
        </rule>

        <rule name="Skip legacy uploads" stopProcessing="true">
          <match url="^wp-content/uploads/" />
          <action type="None" />
        </rule>

        <!-- ============================================================
             1. Strip the ?no-cache= parameter trap (infinite duplicate URLs)
             ============================================================ -->
        <rule name="Strip no-cache param" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{QUERY_STRING}" pattern="(^|&amp;)no-cache=" />
          </conditions>
          <action type="Redirect" url="https://houseofvacation.com/{R:1}"
                  appendQueryString="false" redirectType="Permanent" />
        </rule>

        <!-- ============================================================
             2. Canonical host + scheme in a SINGLE 301.
                One rule handles http, www, and http+www together, so the
                worst case is one hop - never a chain.
                HTTP_X_FORWARDED_PROTO is checked in case a CDN sits in front.
             ============================================================ -->
        <rule name="Canonical host and scheme" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="^www\." />
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^http$" />
          </conditions>
          <action type="Redirect" url="https://houseofvacation.com/{R:1}"
                  appendQueryString="true" redirectType="Permanent" />
        </rule>

        <!-- ============================================================
             3. Force lowercase URLs
                The old server served /About-Company/ at 200 as a duplicate.
                IIS can fix this generically - Apache cannot without RewriteMap.
             ============================================================ -->
        <rule name="Force lowercase" stopProcessing="true">
          <match url="[A-Z]" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{URL}" pattern="^/wp-content/" negate="true" />
          </conditions>
          <action type="Redirect" url="{ToLower:{R:0}}"
                  appendQueryString="true" redirectType="Permanent" />
        </rule>

        <!-- ============================================================
             4. Force trailing slash on page URLs
                Skips real files, real directories, and extensioned paths.
             ============================================================ -->
        <rule name="Add trailing slash" stopProcessing="true">
          <match url="(.*[^/])$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="\.[a-zA-Z0-9]{2,5}$"        negate="true" />
          </conditions>
          <action type="Redirect" url="{R:1}/"
                  appendQueryString="true" redirectType="Permanent" />
        </rule>

        <!-- ============================================================
             5. SINGLE URL redirects (old -> new, 1:1)
                Add one <add/> per changed URL in the rewriteMap below.
                Always point at the FINAL target, never another redirect.
             ============================================================ -->
        <rule name="Explicit redirect map" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{SeoRedirects:{REQUEST_URI}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}"
                  appendQueryString="false" redirectType="Permanent" />
        </rule>

        <!-- ============================================================
             6. FOLDER redirect - whole tree moves, path preserved
             ============================================================ -->
        <!--
        <rule name="Folder move" stopProcessing="true">
          <match url="^old-section/(.*)$" />
          <action type="Redirect" url="/new-section/{R:1}"
                  redirectType="Permanent" />
        </rule>
        -->

        <!-- ============================================================
             7. WILDCARD redirects - collapse a tree onto one page
             ============================================================ -->
        <rule name="Author archives to blog" stopProcessing="true">
          <match url="^author(/.*)?$" />
          <action type="Redirect" url="/blog/" redirectType="Permanent" />
        </rule>

        <rule name="All feeds to blog" stopProcessing="true">
          <match url="^(.*/)?feed/?$" />
          <action type="Redirect" url="/blog/" redirectType="Permanent" />
        </rule>

        <rule name="WordPress internals" stopProcessing="true">
          <match url="^(wp-admin|wp-json|wp-includes)(/.*)?$|^(wp-login|xmlrpc|index)\.php$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <rule name="Date archives" stopProcessing="true">
          <match url="^(19|20)[0-9]{2}(/[0-9]{2})?(/[0-9]{2})?/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <rule name="Homepage pagination" stopProcessing="true">
          <match url="^page/[0-9]+/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <rule name="Legacy sitemaps" stopProcessing="true">
          <match url="^(sitemap_index|wp-sitemap|post-sitemap|page-sitemap|category-sitemap)\.xml$" />
          <action type="Redirect" url="/sitemap.xml" redirectType="Permanent" />
        </rule>

      </rules>

      <!-- ==============================================================
           Redirect map. Edit this list to add 1:1 redirects - no code
           change and no redeploy required.
           Keys must be lowercase and include the trailing slash, because
           rules 3 and 4 have already normalised the URL by this point.
           ============================================================== -->
      <rewriteMaps>
        <rewriteMap name="SeoRedirects" defaultValue="">
          <add key="/category/uncategorized/" value="/blog/" />
          <add key="/hello-world/"            value="/blog/" />
          <add key="/new-blog/"               value="/blog/" />
          <!-- Add further old -> new pairs here -->
        </rewriteMap>
      </rewriteMaps>
    </rewrite>

    <!-- ===================================================================
         404 handling. ASP.NET Core middleware handles this (see 04_dotnet).
         existingResponse="PassThrough" hands control to the app so the
         middleware can decide between a real 404 and a smart 301.
         =================================================================== -->
    <httpErrors existingResponse="PassThrough" errorMode="Custom">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/page-not-found/" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
