# ============================================================================
#  House of Vacation — PRODUCTION .htaccess
#  Server : Hostinger shared hosting / LiteSpeed (Apache-compatible)
#  Target : public_html/.htaccess
#
#  Canonical URL form:  https://houseofvacation.com/path/   (HTTPS, non-www, trailing slash)
#
#  DESIGN NOTE — why this file is short:
#  Every page is deployed as  folder/index.html , so Apache's DirectoryIndex
#  serves /about-company/ natively at 200 with NO rewrite rule. Clean URLs come
#  from the folder layout, not from rewriting. Fewer rules = fewer ways to break.
#
#  RULE ORDER IS DELIBERATE. Do not reorder.
# ============================================================================

# MultiViews OFF is critical: it stops Apache serving /about-company from
# about-company.html, which would create a duplicate URL alongside the folder.
Options -Indexes -MultiViews

DirectoryIndex index.html index.php

# DirectorySlash gives us /about-company -> /about-company/ as a native 301
# for real directories. No rewrite rule needed.
DirectorySlash On

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ---------------------------------------------------------------------------
# 0. HARD EXCLUSIONS — never rewrite, never redirect.
#
#    /wp-content/uploads/  MUST keep working. 30 live images, referenced by
#    og:image tags and indexed in Google Images. Changing these URLs loses
#    that traffic and breaks social preview cards.
#
#    Placing these first guarantees no later rule can touch an asset.
# ---------------------------------------------------------------------------
RewriteRule ^\.well-known/          - [L]
RewriteRule ^wp-content/uploads/    - [L]
RewriteRule ^assets/                - [L]

# Belt and braces: any real file or directory is served as-is, never rewritten.
# This is what guarantees "no accidental redirects of images/CSS/JS".
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------------------------------------------------------------------------
# 1. Strip the ?no-cache= parameter trap
#    The old WordPress build emitted infinite unique ?no-cache=<hex> URLs, all
#    serving duplicate content at 200. Collapse them onto the clean URL.
#    The trailing "?" discards the query string entirely.
# ---------------------------------------------------------------------------
RewriteCond %{QUERY_STRING} (^|&)no-cache=[^&]* [NC]
RewriteRule ^(.*)$ /$1? [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)attachment_id=[0-9]+ [NC]
RewriteRule ^(.*)$ /$1? [R=301,L]

# ---------------------------------------------------------------------------
# 2. Canonical host + scheme — ONE rule, ONE hop
#
#    Handling http, www, and http+www in a single rule is what prevents the
#    classic 2-hop chain (http://www -> https://www -> https://).
#
#    X-Forwarded-Proto is checked because Hostinger puts a CDN (hcdn) in front.
#    Without it %{HTTPS} reads "off" at origin and you get an INFINITE LOOP.
# ---------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ - [E=NEEDS_HTTPS:1]

RewriteCond %{ENV:NEEDS_HTTPS} =1 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://houseofvacation.com%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# 3. Collapse duplicate entry points onto the canonical URL
#    Without these, /about-company/ and /about-company/index.html both return
#    200 with identical content.
# ---------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(html|php)[\s?] [NC]
RewriteRule ^(.*)index\.(html|php)$ /%1 [R=301,L]

# Direct .html access -> clean folder URL  (/about.html -> /about-company/)
# Only fires for requests that literally asked for .html; internal rewrites
# are unaffected.
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# ---------------------------------------------------------------------------
# 4. 301 REDIRECT MAP  (from 01_redirect-map.csv)
#    Every target is a FINAL destination — never another redirect.
#    This is what guarantees "no redirect chains".
# ---------------------------------------------------------------------------

# --- Obsolete WordPress content -> nearest live equivalent
RewriteRule ^category/uncategorized/?$        /blog/  [R=301,L]
RewriteRule ^hello-world/?$                   /blog/  [R=301,L]
RewriteRule ^new-blog/?$                      /blog/  [R=301,L]
RewriteRule ^author(/.*)?$                    /blog/  [R=301,L]

# --- Feeds
RewriteRule ^feed/?$                          /blog/  [R=301,L]
RewriteRule ^comments/feed/?$                 /blog/  [R=301,L]
RewriteRule ^.+/feed/?$                       /blog/  [R=301,L]

# --- WordPress internals that no longer exist
RewriteRule ^wp-login\.php$                   /  [R=301,L]
RewriteRule ^xmlrpc\.php$                     /  [R=301,L]
RewriteRule ^wp-admin(/.*)?$                  /  [R=301,L]
RewriteRule ^wp-json(/.*)?$                   /  [R=301,L]
RewriteRule ^wp-includes(/.*)?$               /  [R=301,L]
RewriteRule ^wp-content/(?!uploads/)(.*)$     /  [R=301,L]

# --- Date archives and homepage pagination duplicates
RewriteRule ^(19|20)[0-9]{2}(/[0-9]{2})?(/[0-9]{2})?/?$   /  [R=301,L]
RewriteRule ^page/[0-9]+/?$                   /  [R=301,L]

# --- Legacy sitemaps -> the new single sitemap
RewriteRule ^sitemap_index\.xml$              /sitemap.xml  [R=301,L]
RewriteRule ^wp-sitemap\.xml$                 /sitemap.xml  [R=301,L]
RewriteRule ^(post|page|category)-sitemap\.xml$ /sitemap.xml [R=301,L]

# ---------------------------------------------------------------------------
# 5. TEMPLATE: adding a new redirect later
#
#    Single URL:
#      RewriteRule ^old-page/?$            /new-page/          [R=301,L]
#
#    Whole folder, path preserved:
#      RewriteRule ^old-section/(.*)$      /new-section/$1     [R=301,L]
#
#    Wildcard, collapse a tree onto one page:
#      RewriteRule ^destinations/(.*)$     /destinations/      [R=301,L]
#
#    ALWAYS point at the final destination. Never at another redirect.
# ---------------------------------------------------------------------------

</IfModule>

# ---------------------------------------------------------------------------
# 6. 404 HANDLING
#    A genuine unknown URL returns a REAL 404 with a branded page.
#    It is NOT redirected to the homepage — that produces soft 404s, keeps dead
#    URLs in the index as errors, and hides broken internal links.
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# 7. CACHING
#    The old server sent Cache-Control: no-store on HTML, which is what
#    generated the infinite ?no-cache= URLs. Do not repeat that.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Long cache for fingerprinted static assets
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Never cache HTML at the edge — but never "no-store" either
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 8. Correct MIME types (LiteSpeed usually has these, but be explicit)
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp             .webp
  AddType image/svg+xml          .svg
  AddType font/woff2             .woff2
  AddType application/json       .json
</IfModule>

# ---------------------------------------------------------------------------
# 9. Basic hardening
# ---------------------------------------------------------------------------
<FilesMatch "^\.(htaccess|htpasswd|env|git)">
  Require all denied
</FilesMatch>
